# Copy to .env (never commit it).
# Required for the current year's fire detections: free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
# Optional: CPCB ground PM2.5 via OpenAQ v3, key from https://explore.openaq.org/register
OPENAQ_API_KEY=
# Optional: data.gov.in OGD API, key from https://data.gov.in/ (used for some enforcement tables)
DATAGOV_API_KEY=
